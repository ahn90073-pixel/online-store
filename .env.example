# Local-only example. Copy to .env and replace every value with your Firebase Web app config.
# These VITE_* values are bundled into the browser and are NOT Firebase Admin secrets.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_DATABASE_URL=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Existing optional Supabase values, if used by another part of the project.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
